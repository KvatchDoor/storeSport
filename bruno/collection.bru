headers {
  Accept: application/json
}

auth {
  mode: none
}

docs {
  # sportStore — API HTTP

  Collection de tests fonctionnels de l'API `/store/articles`.

  Toutes les requetes utilisent la variable d'environnement `baseUrl`
  (voir `environments/local.bru`).

  L'application doit tourner avant l'execution : `mvn spring-boot:run`.
}
